# Copy to .env and fill in. Never commit real keys.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Business
BRAND_NAME=Bayou City Greens
CONTACT_EMAIL=hello@bayoucitygreens.com
CONTACT_PHONE=
PICKUP_ADDRESS=Houston, TX (exact pickup address shared after you order)

# Delivery (comma-separated ZIP codes you serve)
DELIVERY_FEE=4.95
FREE_DELIVERY_MINIMUM=35.00

# Stripe — leave blank until you're ready to take online payments.
# See README.md "Linking Stripe" for setup steps.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
